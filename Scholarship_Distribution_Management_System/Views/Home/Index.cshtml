@{
    ViewData["Title"] = "School Home Page";
}

<h2>Trang chủ</h2>

<div class="welcome-box">
    <p class="welcome-message">
        Chào mừng bạn đến với hệ thống quản lý phân phát học bổng cho sinh viên trường đại học Sư phạm Kỹ thuật Đà Nẵng
    </p>
    <div class="login-prompt">
        <p>Để sử dụng hệ thống, vui lòng đăng nhập</p>
        <div class="login-buttons">
            <button class="button-primary"><i class="fas fa-user-graduate"></i> Đăng nhập cho sinh viên</button>
            <button class="button-primary"><i class="fas fa-user-tie"></i> Đăng nhập cho cán bộ</button>
        </div>
    </div>
</div>