@model IEnumerable<Scholarship_Distribution_Management_System.Models.Entities.DotHocBong>

@{
    ViewData["Title"] = "Duyệt điểm học tập";
    var now = DateTime.UtcNow;
}

<div class="scholarship-dashboard">
    <div class="dashboard-header">
        <div class="header-content">
            <h2><i class="fas fa-graduation-cap"></i> Đợt xét duyệt học bổng</h2>
            <p class="text-muted">Quản lý và duyệt các đợt học bổng hiện có trong hệ thống</p>
        </div>
        <div class="header-actions">
            <div class="input-group search-box">
                <input type="text" id="searchScholarship" class="form-control" placeholder="Tìm kiếm đợt học bổng...">
                <button class="btn btn-outline-secondary" type="button">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="status-filters">
        <button class="filter-btn active" data-filter="all">Tất cả</button>
        <button class="filter-btn" data-filter="upcoming">Sắp mở</button>
        <button class="filter-btn" data-filter="open">Đang mở</button>
        <button class="filter-btn" data-filter="reviewing">Đang xét duyệt</button>
        <button class="filter-btn" data-filter="closed">Kết thúc</button>
    </div>

    <div class="scholarship-timeline">
        @foreach (var item in Model)
        {
            string statusClass;
            string statusText;
            string statusIcon;

            if (now < item.NgayBatDauNop)
            {
                statusClass = "upcoming";
                statusText = "Sắp mở";
                statusIcon = "calendar-plus";
            }
            else if (now >= item.NgayBatDauNop && now <= item.NgayKetThucNop)
            {
                statusClass = "open";
                statusText = "Đang mở";
                statusIcon = "door-open";
            }
            else if (now > item.NgayKetThucNop && now <= item.NgayKetThuc)
            {
                statusClass = "reviewing";
                statusText = "Đang xét duyệt";
                statusIcon = "clipboard-check";
            }
            else
            {
                statusClass = "closed";
                statusText = "Kết thúc";
                statusIcon = "check-circle";
            }

            <div class="timeline-item @statusClass">
                <div class="timeline-marker">
                    <div class="marker-icon">
                        <i class="fas fa-@statusIcon"></i>
                    </div>
                    <div class="marker-line"></div>
                </div>
                
                <div class="timeline-content">
                    <div class="content-header">
                        <h3 class="scholarship-title">@item.TenDot</h3>
                        <span class="status-badge @statusClass">
                            <i class="fas fa-@statusIcon"></i> @statusText
                        </span>
                    </div>
                    
                    <div class="scholarship-details">
                        <div class="detail-item">
                            <i class="fas fa-info-circle"></i>
                            <p>@item.DieuKien</p>
                        </div>
                        
                        <div class="detail-dates">
                            <div class="date-item">
                                <i class="fas fa-calendar-alt"></i>
                                <span>Ngày tạo: @item.NgayTao.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="date-item">
                                <i class="fas fa-calendar-check"></i>
                                <span>Thời gian nộp: @item.NgayBatDauNop.ToString("dd/MM/yyyy") - @item.NgayKetThucNop.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>
                        
                    </div>
                    
                    <div class="action-buttons">
                        <a class="btn-action details" asp-action="Details" asp-route-id="@item.ID">
                            <i class="fas fa-eye"></i> Xem chi tiết
                        </a>
                        <a class="btn-action review" asp-action="Index" asp-controller="XetDuyetHoSo" asp-route-IdDot="@item.ID">
                            <i class="fas fa-list-check"></i> Danh sách hồ sơ cần duyệt
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .scholarship-dashboard {
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px 0;
    }
    
    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 20px;
    }
    
    .header-content h2 {
        font-size: 1.8rem;
        margin-bottom: 5px;
        font-weight: 700;
        color: #1e3a8a;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .header-content p {
        margin-bottom: 0;
        color: #64748b;
    }
    
    .search-box {
        width: 300px;
    }
    
    .status-filters {
        display: flex;
        gap: 10px;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }
    
    .filter-btn {
        padding: 8px 16px;
        background-color: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        font-size: 0.85rem;
        color: #64748b;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    
    .filter-btn:hover {
        background-color: #e2e8f0;
    }
    
    .filter-btn.active {
        background-color: #1e3a8a;
        color: white;
        border-color: #1e3a8a;
    }
    
    .scholarship-timeline {
        position: relative;
    }
    
    .timeline-item {
        display: flex;
        margin-bottom: 40px;
    }
    
    .timeline-marker {
        position: relative;
        width: 60px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    
    .marker-icon {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background-color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        z-index: 2;
    }
    
    .timeline-item.upcoming .marker-icon {
        color: #3b82f6;
        border: 2px solid #3b82f6;
    }
    
    .timeline-item.open .marker-icon {
        color: #10b981;
        border: 2px solid #10b981;
    }
    
    .timeline-item.reviewing .marker-icon {
        color: #f59e0b;
        border: 2px solid #f59e0b;
    }
    
    .timeline-item.closed .marker-icon {
        color: #6b7280;
        border: 2px solid #6b7280;
    }
    
    .marker-line {
        position: absolute;
        top: 50px;
        width: 3px;
        height: calc(100% + 40px);
        background-color: #e2e8f0;
        z-index: 1;
    }
    
    .timeline-item:last-child .marker-line {
        display: none;
    }
    
    .timeline-content {
        flex: 1;
        background-color: white;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.07);
        padding: 20px;
        margin-left: 20px;
        transition: all 0.3s ease;
    }
    
    .timeline-item:hover .timeline-content {
        transform: translateY(-5px);
        box-shadow: 0 8px 15px rgba(0,0,0,0.1);
    }
    
    .content-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        flex-wrap: wrap;
        gap: 15px;
    }
    
    .scholarship-title {
        font-size: 1.3rem;
        font-weight: 600;
        margin: 0;
        color: #1e293b;
    }
    
    .status-badge {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    
    .status-badge.upcoming {
        background-color: #eff6ff;
        color: #3b82f6;
    }
    
    .status-badge.open {
        background-color: #ecfdf5;
        color: #10b981;
    }
    
    .status-badge.reviewing {
        background-color: #fffbeb;
        color: #f59e0b;
    }
    
    .status-badge.closed {
        background-color: #f1f5f9;
        color: #6b7280;
    }
    
    .scholarship-details {
        margin-bottom: 20px;
    }
    
    .detail-item {
        display: flex;
        gap: 10px;
        margin-bottom: 15px;
    }
    
    .detail-item i {
        margin-top: 3px;
        color: #475569;
    }
    
    .detail-item p {
        margin: 0;
        color: #334155;
        line-height: 1.5;
        flex: 1;
    }
    
    .detail-dates {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 15px;
    }
    
    .date-item {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #475569;
        font-size: 0.9rem;
    }
    
    .progress-container {
        margin-top: 15px;
    }
    
    .progress {
        height: 8px;
        border-radius: 4px;
        background-color: #e2e8f0;
        margin-bottom: 5px;
    }
    
    .progress-bar-upcoming {
        background-color: #3b82f6;
    }
    
    .progress-bar-open {
        background-color: #10b981;
    }
    
    .progress-bar-reviewing {
        background-color: #f59e0b;
    }
    
    .progress-bar-closed {
        background-color: #6b7280;
    }
    
    .progress-text {
        font-size: 0.85rem;
        color: #64748b;
    }
    
    .action-buttons {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
    }
    
    .btn-action {
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 500;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
    }
    
    .btn-action.details {
        background-color: #f1f5f9;
        color: #334155;
    }
    
    .btn-action.details:hover {
        background-color: #e2e8f0;
        color: #1e293b;
    }
    
    .btn-action.review {
        background-color: #1e40af;
        color: white;
    }
    
    .btn-action.review:hover {
        background-color: #1e3a8a;
    }
    
    @@media (max-width: 768px) {
        .dashboard-header {
            flex-direction: column;
            align-items: flex-start;
        }
        
        .search-box {
            width: 100%;
        }
        
        .timeline-marker {
            width: 40px;
        }
        
        .marker-icon {
            width: 40px;
            height: 40px;
            font-size: 1rem;
        }
        
        .marker-line {
            top: 40px;
        }
        
        .scholarship-title {
            font-size: 1.1rem;
        }
        
        .action-buttons {
            flex-direction: column;
        }
        
        .btn-action {
            width: 100%;
            justify-content: center;
        }
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Search functionality
            $("#searchScholarship").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $(".timeline-item").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
            
            // Filter buttons
            $(".filter-btn").on("click", function() {
                var filter = $(this).data("filter");
                
                // Update active button
                $(".filter-btn").removeClass("active");
                $(this).addClass("active");
                
                // Filter items
                if (filter === "all") {
                    $(".timeline-item").show();
                } else {
                    $(".timeline-item").hide();
                    $(".timeline-item." + filter).show();
                }
            });
        });
    </script>
}

