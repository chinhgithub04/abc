@model Scholarship_Distribution_Management_System.Models.Entities.HoatDong
@{
    ViewData["Title"] = "Sửa hoạt động";
}

<h2>Sửa hoạt động</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="ID" />
    <div class="mb-3">
        <label asp-for="TenHoatDong" class="form-label">Tên hoạt động</label>
        <input asp-for="TenHoatDong" class="form-control" />
        <span asp-validation-for="TenHoatDong" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Cập nhật</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
