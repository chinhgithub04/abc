@model IEnumerable<Scholarship_Distribution_Management_System.Models.Entities.HoatDong>
@{
    ViewData["Title"] = "Danh sách hoạt động";
}

<h2 class="mb-3">Danh sách hoạt động</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Thêm hoạt động</a>

<table class="table table-bordered table-striped" id="HoatDongTable">
    <thead class="table-light">
        <tr>
            <th>STT</th>
            <th>Tên hoạt động</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(Model.ToList().IndexOf(item) + 1)</td>
                <td>@item.TenHoatDong</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info">Xem</a>
                    <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning">Sửa</a>    
                    <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-danger" onclick="return confirm('Bạn chắc chắn muốn xóa?')">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <script>
        $(document).ready(function() {
            // Khởi tạo DataTables trên bảng có ID là 'duyetDiemTable'
            $('#HoatDongTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Vietnamese.json" // Ngôn ngữ tiếng Việt
                },
                "paging": true,       // Bật phân trang
                "ordering": true,     // Bật sắp xếp cột
                "info": true,         // Bật thông tin bảng (Hiển thị X đến Y của Z mục)
                "searching": true,    // Bật ô tìm kiếm toàn cục
                "responsive": true    // Bật chế độ responsive cho bảng
            });
        });
    </script>
}