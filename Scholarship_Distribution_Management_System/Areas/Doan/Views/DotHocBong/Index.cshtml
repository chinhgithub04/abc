@model IEnumerable<Scholarship_Distribution_Management_System.Models.Entities.DotHocBong>

@{
    ViewData["Title"] = "Duyệt hoạt động sinh viên";
}

<div class="scholarship-dashboard">
    <!-- Page Header -->
    <div class="page-header">
        <div class="header-content">
            <h1>Duyệt hoạt động sinh viên</h1>
            <p>Quản lý và duyệt các hoạt động sinh viên theo từng đợt học bổng</p>
        </div>
        <div class="header-actions">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="searchInput" placeholder="Tìm kiếm đợt..." class="form-control">
            </div>
            <div class="filter-box">
                <button class="btn btn-filter" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-filter"></i> Lọc
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item filter-option" data-filter="all" href="#">Tất cả</a></li>
                    <li><a class="dropdown-item filter-option" data-filter="upcoming" href="#">Sắp mở</a></li>
                    <li><a class="dropdown-item filter-option" data-filter="active" href="#">Đang mở</a></li>
                    <li><a class="dropdown-item filter-option" data-filter="reviewing" href="#">Đang xét duyệt</a></li>
                    <li><a class="dropdown-item filter-option" data-filter="ended" href="#">Kết thúc</a></li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="stat-cards">
        <div class="stat-card upcoming">
            <div class="stat-icon"><i class="fas fa-hourglass-start"></i></div>
            <div class="stat-content">
                <h3 id="upcomingCount">0</h3>
                <p>Sắp mở</p>
            </div>
        </div>
        <div class="stat-card active">
            <div class="stat-icon"><i class="fas fa-folder-open"></i></div>
            <div class="stat-content">
                <h3 id="activeCount">0</h3>
                <p>Đang mở</p>
            </div>
        </div>
        <div class="stat-card reviewing">
            <div class="stat-icon"><i class="fas fa-tasks"></i></div>
            <div class="stat-content">
                <h3 id="reviewingCount">0</h3>
                <p>Đang xét duyệt</p>
            </div>
        </div>
        <div class="stat-card ended">
            <div class="stat-icon"><i class="fas fa-check-double"></i></div>
            <div class="stat-content">
                <h3 id="endedCount">0</h3>
                <p>Kết thúc</p>
            </div>
        </div>
    </div>

    <!-- Scholarships Timeline View -->
    <div class="timeline-container">
        <div class="timeline-filter-indicator">
            <span id="currentFilter">Tất cả đợt xét duyệt</span>
            <span id="resultCount">(@Model.Count() đợt)</span>
        </div>
        
        <div class="timeline">
            @foreach (var item in Model)
            {
                var now = DateTime.UtcNow;
                string statusClass;
                string statusText;
                string statusIcon;

                if (now < item.NgayBatDauNop)
                {
                    statusClass = "upcoming";
                    statusText = "Sắp mở";
                    statusIcon = "hourglass-start";
                }
                else if (now >= item.NgayBatDauNop && now <= item.NgayKetThucNop)
                {
                    statusClass = "active";
                    statusText = "Đang mở";
                    statusIcon = "folder-open";
                }
                else if (now > item.NgayKetThucNop && now <= item.NgayHoiDongDuyet)
                {
                    statusClass = "reviewing";
                    statusText = "Đang xét duyệt";
                    statusIcon = "tasks";
                }
                else
                {
                    statusClass = "ended";
                    statusText = "Kết thúc";
                    statusIcon = "check-double";
                }

                <div class="timeline-item @statusClass" data-status="@statusClass">
                    <div class="timeline-badge">
                        <i class="fas fa-@statusIcon"></i>
                    </div>
                    <div class="timeline-panel">
                        <div class="timeline-header">
                            <div class="title-section">
                                <h3>@item.TenDot</h3>
                                <span class="status-badge @statusClass">
                                    <i class="fas fa-@statusIcon"></i> @statusText
                                </span>
                            </div>
                            <div class="date-section">
                                <span class="created-date">
                                    <i class="fas fa-calendar-plus"></i> @item.NgayTao.ToString("dd/MM/yyyy")
                                </span>
                            </div>
                        </div>
                        
                        <div class="timeline-body">
                            <div class="timeline-description">
                                <p><i class="fas fa-info-circle"></i> <strong>Điều kiện:</strong> @item.DieuKien</p>
                            </div>
                            
                            <div class="timeline-dates">
                                <div class="date-item">
                                    <i class="fas fa-calendar-alt"></i>
                                    <div>
                                        <span>Thời gian nộp:</span>
                                        <strong>@item.NgayBatDauNop.ToString("dd/MM/yyyy") - @item.NgayKetThucNop.ToString("dd/MM/yyyy")</strong>
                                    </div>
                                </div>
                                <div class="date-item">
                                    <i class="fas fa-calendar-check"></i>
                                    <div>
                                        <span>Thời gian xét duyệt:</span>
                                        <strong>@item.NgayKetThucNop.ToString("dd/MM/yyyy") - @item.NgayHoiDongDuyet.ToString("dd/MM/yyyy")</strong>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="timeline-actions">
                                <a class="btn btn-primary" asp-action="Details" asp-route-id="@item.ID">
                                    <i class="fas fa-info-circle"></i> Chi tiết
                                </a>
                                <a class="btn btn-success" asp-action="Index" asp-controller="DuyetHoatDong" asp-route-IdDot="@item.ID">
                                    <i class="fas fa-clipboard-check"></i> Duyệt hồ sơ
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* Dashboard Styles */
    .scholarship-dashboard {
        padding: 20px 0;
    }
    
    /* Page Header */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 20px;
    }
    
    .header-content h1 {
        font-size: 28px;
        font-weight: 700;
        margin: 0 0 8px 0;
        color: #2c3e50;
    }
    
    .header-content p {
        font-size: 16px;
        color: #7f8c8d;
        margin: 0;
    }
    
    .header-actions {
        display: flex;
        gap: 15px;
    }
    
    .search-box {
        position: relative;
    }
    
    .search-box i {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #95a5a6;
    }
    
    .search-box input {
        padding-left: 40px;
        width: 250px;
        border-radius: 50px;
        border: 1px solid #e5e5e5;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }
    
    .btn-filter {
        background-color: #f8f9fa;
        border: 1px solid #e5e5e5;
        color: #444;
        padding: 0.375rem 1rem;
        border-radius: 50px;
        display: flex;
        align-items: center;
        gap: 8px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }
    
    .btn-filter:hover {
        background-color: #e9ecef;
    }
    
    /* Statistics Cards */
    .stat-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }
    
    .stat-card {
        background: white;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        display: flex;
        align-items: center;
        transition: transform 0.3s, box-shadow 0.3s;
        cursor: pointer;
    }
    
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }
    
    .stat-card.upcoming {
        border-left: 4px solid #3498db;
    }
    
    .stat-card.active {
        border-left: 4px solid #2ecc71;
    }
    
    .stat-card.reviewing {
        border-left: 4px solid #f39c12;
    }
    
    .stat-card.ended {
        border-left: 4px solid #95a5a6;
    }
    
    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
        font-size: 20px;
    }
    
    .stat-card.upcoming .stat-icon {
        background-color: rgba(52, 152, 219, 0.1);
        color: #3498db;
    }
    
    .stat-card.active .stat-icon {
        background-color: rgba(46, 204, 113, 0.1);
        color: #2ecc71;
    }
    
    .stat-card.reviewing .stat-icon {
        background-color: rgba(243, 156, 18, 0.1);
        color: #f39c12;
    }
    
    .stat-card.ended .stat-icon {
        background-color: rgba(149, 165, 166, 0.1);
        color: #95a5a6;
    }
    
    .stat-content h3 {
        font-size: 24px;
        font-weight: 700;
        margin: 0 0 5px 0;
    }
    
    .stat-content p {
        margin: 0;
        color: #7f8c8d;
    }
    
    /* Timeline Filter Indicator */
    .timeline-filter-indicator {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
        font-size: 18px;
        font-weight: 600;
        color: #2c3e50;
    }
    
    .timeline-filter-indicator #resultCount {
        margin-left: 8px;
        font-size: 16px;
        font-weight: 400;
        color: #7f8c8d;
    }
    
    /* Timeline */
    .timeline {
        position: relative;
        padding: 20px 0;
    }
    
    .timeline:before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 20px;
        width: 4px;
        background: #e5e5e5;
        border-radius: 2px;
    }
    
    .timeline-item {
        position: relative;
        margin-bottom: 30px;
        margin-left: 45px;
    }
    
    .timeline-badge {
        position: absolute;
        left: -45px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        z-index: 1;
    }
    
    .timeline-item.upcoming .timeline-badge {
        background-color: #3498db;
    }
    
    .timeline-item.active .timeline-badge {
        background-color: #2ecc71;
    }
    
    .timeline-item.reviewing .timeline-badge {
        background-color: #f39c12;
    }
    
    .timeline-item.ended .timeline-badge {
        background-color: #95a5a6;
    }
    
    .timeline-panel {
        background: white;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        overflow: hidden;
        transition: transform 0.3s, box-shadow 0.3s;
    }
    
    .timeline-item:hover .timeline-panel {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }
    
    .timeline-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 20px;
        border-bottom: 1px solid #f1f1f1;
    }
    
    .title-section {
        flex: 1;
    }
    
    .title-section h3 {
        font-size: 18px;
        font-weight: 600;
        margin: 0 0 10px 0;
        color: #2c3e50;
    }
    
    .status-badge {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 500;
    }
    
    .status-badge.upcoming {
        background-color: rgba(52, 152, 219, 0.1);
        color: #3498db;
    }
    
    .status-badge.active {
        background-color: rgba(46, 204, 113, 0.1);
        color: #2ecc71;
    }
    
    .status-badge.reviewing {
        background-color: rgba(243, 156, 18, 0.1);
        color: #f39c12;
    }
    
    .status-badge.ended {
        background-color: rgba(149, 165, 166, 0.1);
        color: #95a5a6;
    }
    
    .status-badge i {
        margin-right: 5px;
    }
    
    .date-section {
        color: #7f8c8d;
        font-size: 14px;
        text-align: right;
    }
    
    .created-date {
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }
    
    .timeline-body {
        padding: 20px;
    }
    
    .timeline-description {
        margin-bottom: 20px;
        color: #34495e;
    }
    
    .timeline-description p {
        margin: 0;
    }
    
    .timeline-dates {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 20px;
    }
    
    .date-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-size: 14px;
        flex: 1;
        min-width: 280px;
    }
    
    .date-item i {
        color: #7f8c8d;
        margin-top: 3px;
    }
    
    .date-item div {
        display: flex;
        flex-direction: column;
    }
    
    .timeline-actions {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }
    
    .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s;
    }
    
    .progress-container {
        margin-top: 15px;
    }
    
    .progress-label {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 14px;
        color: #7f8c8d;
    }
    
    .progress {
        height: 10px;
        border-radius: 5px;
        background-color: #f1f1f1;
    }
    
    .progress-bar {
        border-radius: 5px;
    }
    
    .bg-upcoming {
        background-color: #3498db;
    }
    
    .bg-active {
        background-color: #2ecc71;
    }
    
    .bg-reviewing {
        background-color: #f39c12;
    }
    
    .bg-ended {
        background-color: #95a5a6;
    }
    
    /* Responsive Adjustments */
    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }
        
        .header-actions {
            width: 100%;
            flex-wrap: wrap;
        }
        
        .search-box {
            flex: 1;
            min-width: 200px;
        }
        
        .search-box input {
            width: 100%;
        }
        
        .timeline:before {
            left: 15px;
        }
        
        .timeline-item {
            margin-left: 35px;
        }
        
        .timeline-badge {
            left: -35px;
            width: 30px;
            height: 30px;
            font-size: 12px;
        }
        
        .timeline-header {
            flex-direction: column;
        }
        
        .date-section {
            text-align: left;
            margin-top: 10px;
        }
        
        .timeline-dates {
            flex-direction: column;
            gap: 10px;
        }
        
        .date-item {
            min-width: auto;
        }
        
        .timeline-actions {
            flex-wrap: wrap;
        }
        
        .timeline-actions .btn {
            flex: 1;
            min-width: 120px;
            justify-content: center;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Count items by status and update stat cards
        updateStatusCounts();
        
        // Search functionality
        const searchInput = document.getElementById('searchInput');
        searchInput.addEventListener('input', filterItems);
        
        // Filter functionality
        const filterOptions = document.querySelectorAll('.filter-option');
        filterOptions.forEach(option => {
            option.addEventListener('click', function(e) {
                e.preventDefault();
                const filter = this.dataset.filter;
                applyFilter(filter);
            });
        });
        
        // Stat card filtering
        const statCards = document.querySelectorAll('.stat-card');
        statCards.forEach(card => {
            card.addEventListener('click', function() {
                const status = this.classList[1]; // Get the status class (upcoming, active, etc.)
                applyFilter(status);
            });
        });
        
        // Functions
        function updateStatusCounts() {
            const upcomingItems = document.querySelectorAll('.timeline-item.upcoming');
            const activeItems = document.querySelectorAll('.timeline-item.active');
            const reviewingItems = document.querySelectorAll('.timeline-item.reviewing');
            const endedItems = document.querySelectorAll('.timeline-item.ended');
            
            document.getElementById('upcomingCount').textContent = upcomingItems.length;
            document.getElementById('activeCount').textContent = activeItems.length;
            document.getElementById('reviewingCount').textContent = reviewingItems.length;
            document.getElementById('endedCount').textContent = endedItems.length;
        }
        
        function filterItems() {
            const searchText = searchInput.value.toLowerCase();
            const items = document.querySelectorAll('.timeline-item');
            let visibleCount = 0;
            
            items.forEach(item => {
                const title = item.querySelector('h3').textContent.toLowerCase();
                const description = item.querySelector('.timeline-description').textContent.toLowerCase();
                
                if (title.includes(searchText) || description.includes(searchText)) {
                    item.style.display = '';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });
            
            document.getElementById('resultCount').textContent = `(${visibleCount} đợt)`;
        }
        
        function applyFilter(filter) {
            const items = document.querySelectorAll('.timeline-item');
            let visibleCount = 0;
            let filterText = '';
            
            items.forEach(item => {
                if (filter === 'all') {
                    item.style.display = '';
                    visibleCount++;
                    filterText = 'Tất cả đợt xét duyệt';
                } else if (item.dataset.status === filter) {
                    item.style.display = '';
                    visibleCount++;
                    
                    switch(filter) {
                        case 'upcoming':
                            filterText = 'Đợt sắp mở';
                            break;
                        case 'active':
                            filterText = 'Đợt đang mở';
                            break;
                        case 'reviewing':
                            filterText = 'Đợt đang xét duyệt';
                            break;
                        case 'ended':
                            filterText = 'Đợt đã kết thúc';
                            break;
                    }
                } else {
                    item.style.display = 'none';
                }
            });
            
            document.getElementById('currentFilter').textContent = filterText;
            document.getElementById('resultCount').textContent = `(${visibleCount} đợt)`;
            
            // Clear search when filtering
            searchInput.value = '';
        }
    });
</script>

