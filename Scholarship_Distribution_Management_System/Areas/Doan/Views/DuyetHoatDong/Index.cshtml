@model IEnumerable<Scholarship_Distribution_Management_System.Models.ViewModel.HoatDongCuaSinhVienViewModel>

@{
    ViewData["Title"] = "Danh sách duyệt hoạt động";
}

<h2>Danh sách duyệt hoạt động</h2>

<table class="table table-bordered table-striped" id="Table">
    <thead class="table-light">
        <tr>
            <th>STT</th>
            <th>ID Sinh viên</th>
            <th>Tên hoạt động</th> 
            <th>ID Đơn</th>
            <th>Trạng thái</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(Model.ToList().IndexOf(item) + 1)</td>
                <td>@item.IDSinhVien</td>
                <td>@item.TenHoatDong</td>
                <td>@item.IDDon</td>
                <td>
                    @if (item.DaDuyet)
                    {
                        <span class="badge bg-success">Đã duyệt</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Chưa xác nhận</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <script>
        $(document).ready(function() {
            // Khởi tạo DataTables trên bảng có ID là 'duyetDiemTable'
            $('#Table').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Vietnamese.json" // Ngôn ngữ tiếng Việt
                },
                "paging": true,       // Bật phân trang
                "ordering": true,     // Bật sắp xếp cột
                "info": true,         // Bật thông tin bảng (Hiển thị X đến Y của Z mục)
                "searching": true,    // Bật ô tìm kiếm toàn cục
                "responsive": true    // Bật chế độ responsive cho bảng
            });
        });
    </script>
}