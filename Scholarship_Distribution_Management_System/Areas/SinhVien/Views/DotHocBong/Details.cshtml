@model Scholarship_Distribution_Management_System.Models.Entities.DotHocBong

@using Microsoft.AspNetCore.Identity
@using Scholarship_Distribution_Management_System.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@using System.Security.Claims

@{
    ViewData["Title"] = "Chi tiết đợt học bổng";
}
<div class="card">
    <div class="card-header bg-primary text-white fw-bold fs-5">
        📝 @Model.TenDot
    </div>

    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4 text-muted">Điều kiện</dt>
            <dd class="col-sm-8">@Model.DieuKien</dd>

            <dt class="col-sm-4 text-muted">Số lượng</dt>
            <dd class="col-sm-8">@Model.SoLuong</dd>

            <dt class="col-sm-4 text-muted">Tiền học bổng</dt>
            <dd class="col-sm-8">@Model.Tien.ToString("N0") VNĐ</dd>

            <dt class="col-sm-4 text-muted">Trạng thái</dt>
            <dd class="col-sm-8">
                @{
                    var now = DateTime.UtcNow;

                    string statusText;
                    string statusColor;

                    if (Model.TrangThai == 0)
                    {
                        statusText = "Đã hủy";
                        statusColor = "danger";
                    }
                    else if (Model.TrangThai == 1)
                    {
                        if (now < Model.NgayBatDauNop)
                        {
                            statusText = "Sắp mở";
                            statusColor = "info";
                        }
                        else if (now >= Model.NgayBatDauNop && now <= Model.NgayKetThucNop)
                        {
                            statusText = "Đang mở";
                            statusColor = "success";
                        }
                        else if (now > Model.NgayKetThucNop && now <= Model.NgayKetThuc)
                        {
                            statusText = "Đang xét duyệt";
                            statusColor = "warning";
                        }
                        else if (now > Model.NgayKetThuc)
                        {
                            statusText = "Kết thúc";
                            statusColor = "secondary";
                        }
                        else
                        {
                            statusText = "Không xác định";
                            statusColor = "dark";
                        }
                    }
                    else
                    {
                        statusText = "Không xác định";
                        statusColor = "dark";
                    }
                }
                <span class="badge bg-@statusColor">@statusText</span>
            </dd>

            <dt class="col-sm-4 text-muted">Ngày tạo</dt>
            <dd class="col-sm-8">@Model.NgayTao.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4 text-muted">Thời gian nộp hồ sơ</dt>
            <dd class="col-sm-8">@Model.NgayBatDauNop.ToString("dd/MM/yyyy") → @Model.NgayKetThucNop.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4 text-muted">Ngày xét duyệt</dt>
            <dd class="col-sm-8">@Model.NgayKetThucNop.ToString("dd/MM/yyyy") → @Model.NgayHoiDongDuyet.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4 text-muted">Ngày hội đồng duyệt</dt>
            <dd class="col-sm-8">@Model.NgayHoiDongDuyet.ToString("dd/MM/yyyy") → @Model.NgayPTCDuyet.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4 text-muted">Ngày PTC duyệt</dt>
            <dd class="col-sm-8">@Model.NgayPTCDuyet.ToString("dd/MM/yyyy") → @Model.NgayKetThuc.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4 text-muted">Ngày kết thúc</dt>
            <dd class="col-sm-8">@Model.NgayKetThuc.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4 text-muted">Người phụ trách</dt>
            <dd class="col-sm-8">@Model.NhanVien?.HoTen</dd>
        </dl>
    </div>

    <div class="card-footer text-end">
        <a asp-action="Index" class="btn btn-outline-secondary">
            ⬅ Quay lại
        </a>

        @if ((bool)ViewBag.DaDangKy)
        {
            <a asp-area="SinhVien" asp-controller="DangKyHoSo" asp-action="Index"
               class="btn btn-info">Xem trạng thái đơn</a>
        }
        else
        {
            var dot = Model;
            if (dot.NgayBatDauNop <= DateTime.Now && DateTime.Now <= dot.NgayKetThucNop)
            {
                <a asp-area="SinhVien" asp-controller="DangKyHoSo" asp-action="Create" asp-route-idDot="@dot.ID"
                   class="btn btn-primary ml-2">Đăng ký học bổng</a>
            }
        }

    </div>
</div>
