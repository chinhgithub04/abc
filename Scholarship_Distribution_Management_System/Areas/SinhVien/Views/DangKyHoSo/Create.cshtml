@model Scholarship_Distribution_Management_System.Models.Entities.DonXinHocBong

@{
    ViewData["Title"] = "Đăng ký học bổng";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Header -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-0">
                    <div class="bg-primary text-white p-4 rounded-top">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h2 class="mb-1 fw-bold"><i class="fas fa-graduation-cap me-2"></i>@ViewBag.DotHocBong.TenDot</h2>
                                <p class="mb-0 opacity-75">Mẫu đơn đăng ký học bổng</p>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-light text-primary fs-6 px-3 py-2">
                                    <i class="fas fa-calendar-alt me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy")
                                </span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="p-4">
                        <div class="alert alert-info d-flex align-items-center" role="alert">
                            <i class="fas fa-info-circle fa-lg me-3"></i>
                            <div>
                                Vui lòng điền đầy đủ thông tin bên dưới để đăng ký học bổng. Thông tin sẽ được xét duyệt bởi hội đồng.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <form asp-action="Create" method="post" id="scholarshipForm">
                @* Hidden Fields *@
                <input type="hidden" asp-for="IDDot" />
                <input type="hidden" asp-for="IDSinhVien" />
                <input type="hidden" asp-for="NgayNop" />

                <div class="row">
                    <!-- Thông tin sinh viên -->
                    <div class="col-lg-4 mb-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-header bg-light py-3">
                                <h5 class="mb-0">
                                    <i class="fas fa-user-graduate me-2"></i>Thông tin sinh viên
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="text-center mb-4">
                                    <div class="avatar-placeholder mb-3">
                                        <i class="fas fa-user fa-3x text-muted"></i>
                                    </div>                                    <h5 class="mb-1">@ViewBag.UserDetails.HoTen</h5>
                                    <p class="text-muted mb-0">@Model.IDSinhVien</p>
                                </div>

                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item d-flex justify-content-between px-0">
                                        <span class="text-muted"><i class="fas fa-calendar me-2"></i>Ngày sinh:</span>
                                        <span>@(ViewBag.UserDetails.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between px-0">
                                        <span class="text-muted"><i class="fas fa-venus-mars me-2"></i>Giới tính:</span>
                                        <span>@(ViewBag.UserDetails.GioiTinh ?? "Chưa cập nhật")</span>
                                    </li>
                                    <li class="list-group-item d-flex justify-content-between px-0">
                                        <span class="text-muted"><i class="fas fa-building me-2"></i>Ngành:</span>
                                        <span>@(ViewBag.UserDetails.LopSH?.Nganh?.TenNganh ?? "Chưa cập nhật")</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Thông tin học tập -->
                    <div class="col-lg-8 mb-4">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-light py-3">
                                <h5 class="mb-0">
                                    <i class="fas fa-chart-line me-2"></i>Thông tin học tập & rèn luyện
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="form-floating mb-3">
                                            <input asp-for="DiemHocTap" type="number" step="0.01" min="0" max="4" class="form-control" id="diemHocTap" placeholder="Điểm học tập" required />
                                            <label for="diemHocTap">Điểm học tập (Thang 4)</label>
                                            <span asp-validation-for="DiemHocTap" class="text-danger"></span>
                                            <div class="form-text">Nhập điểm trung bình học tập (hệ 4)</div>
                                        </div>
                                        
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <div class="form-floating mb-3">
                                            <input asp-for="DiemRenLuyen" type="number" step="1" min="0" max="100" class="form-control" id="diemRenLuyen" placeholder="Điểm rèn luyện" required />
                                            <label for="diemRenLuyen">Điểm rèn luyện</label>
                                            <span asp-validation-for="DiemRenLuyen" class="text-danger"></span>
                                            <div class="form-text">Nhập điểm rèn luyện (0-100)</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Nghiên cứu khoa học -->
                    <div class="col-lg-6 mb-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-header bg-light py-3">
                                <h5 class="mb-0">
                                    <i class="fas fa-flask me-2"></i>Nghiên cứu khoa học
                                </h5>
                            </div>
                            <div class="card-body">
                                <p class="text-muted mb-3">Chọn các nghiên cứu khoa học mà bạn đã tham gia:</p>
                                
                                <div class="research-list">
                                    @foreach (var nc in ViewBag.NghienCuuList)
                                    {
                                        <div class="form-check custom-checkbox mb-3">
                                            <input class="form-check-input" type="checkbox" name="selectedNghienCuu" 
                                                   value="@nc.ID" id="@nc.ID" />
                                            <label class="form-check-label d-flex align-items-center" for="@nc.ID">
                                                <span class="me-2"><i class="fas fa-microscope text-primary"></i></span>
                                                <span>@nc.Label</span>
                                            </label>
                                        </div>
                                    }

                                    @if (ViewBag.NghienCuuList.Count == 0)
                                    {
                                        <div class="text-center p-4">
                                            <i class="fas fa-info-circle fa-2x text-muted mb-3"></i>
                                            <p>Không có nghiên cứu khoa học nào được tìm thấy.</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Hoạt động tham gia -->
                    <div class="col-lg-6 mb-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-header bg-light py-3">
                                <h5 class="mb-0">
                                    <i class="fas fa-running me-2"></i>Hoạt động tham gia
                                </h5>
                            </div>
                            <div class="card-body">
                                <p class="text-muted mb-3">Chọn các hoạt động mà bạn đã tham gia:</p>
                                
                                <div class="activities-list">
                                    @foreach (var tenHoatDong in ViewBag.HoatDongList)
                                    {
                                        <div class="form-check custom-checkbox mb-3">
                                            <input class="form-check-input" type="checkbox" name="selectedHoatDong" 
                                                   value="@tenHoatDong" id="@tenHoatDong.Replace(" ", "")" />
                                            <label class="form-check-label d-flex align-items-center" for="@tenHoatDong.Replace(" ", "")">
                                                <span class="me-2"><i class="fas fa-flag text-success"></i></span>
                                                <span>@tenHoatDong</span>
                                            </label>
                                        </div>
                                    }

                                    @if (ViewBag.HoatDongList.Count == 0)
                                    {
                                        <div class="text-center p-4">
                                            <i class="fas fa-info-circle fa-2x text-muted mb-3"></i>
                                            <p>Không có hoạt động nào được tìm thấy.</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Actions -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center">
                            <div class="mb-3 mb-md-0">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="confirmCheck" required>
                                    <label class="form-check-label" for="confirmCheck">
                                        Tôi xác nhận thông tin trên là chính xác
                                    </label>
                                </div>
                            </div>
                            <div class="d-flex">
                                <a href="javascript:history.back()" class="btn btn-outline-secondary me-2">
                                    <i class="fas fa-arrow-left me-1"></i> Quay lại
                                </a>
                                <button type="submit" class="btn btn-primary px-4" id="submitBtn">
                                    <i class="fas fa-paper-plane me-1"></i> Gửi đơn đăng ký
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .avatar-placeholder {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background-color: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
    }
    
    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label {
        opacity: .65;
        transform: scale(.85) translateY(-.5rem) translateX(.15rem);
    }
    
    .custom-checkbox .form-check-input {
        width: 20px;
        height: 20px;
    }
    
    .custom-checkbox .form-check-label {
        padding-left: 0.5rem;
    }
    
    .research-list, .activities-list {
        max-height: 350px;
        overflow-y: auto;
        padding-right: 10px;
    }
    
    .research-list::-webkit-scrollbar, .activities-list::-webkit-scrollbar {
        width: 6px;
    }
    
    .research-list::-webkit-scrollbar-track, .activities-list::-webkit-scrollbar-track {
        background: #f1f1f1;
    }
    
    .research-list::-webkit-scrollbar-thumb, .activities-list::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 3px;
    }
    
    .research-list::-webkit-scrollbar-thumb:hover, .activities-list::-webkit-scrollbar-thumb:hover {
        background: #999;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    
    <script>
        $(document).ready(function() {
            // Progress bar for academic score
            $('#diemHocTap').on('input', function() {
                let val = $(this).val();
                if (val > 4) $(this).val(4);
                if (val < 0) $(this).val(0);
                
                val = Math.min(4, Math.max(0, val));
                const percentage = (val / 4) * 100;
                $('#diemHocTapBar').css('width', percentage + '%');
                
                // Change color based on score
                if (val >= 3.2) {
                    $('#diemHocTapBar').removeClass('bg-warning bg-danger').addClass('bg-success');
                } else if (val >= 2.0) {
                    $('#diemHocTapBar').removeClass('bg-success bg-danger').addClass('bg-warning');
                } else {
                    $('#diemHocTapBar').removeClass('bg-success bg-warning').addClass('bg-danger');
                }
            });
            
            // Progress bar for conduct score
            $('#diemRenLuyen').on('input', function() {
                let val = $(this).val();
                if (val > 100) $(this).val(100);
                if (val < 0) $(this).val(0);
                
                val = Math.min(100, Math.max(0, val));
                const percentage = val;
                $('#diemRenLuyenBar').css('width', percentage + '%');
                
                // Change color based on score
                if (val >= 80) {
                    $('#diemRenLuyenBar').removeClass('bg-warning bg-danger').addClass('bg-primary');
                } else if (val >= 50) {
                    $('#diemRenLuyenBar').removeClass('bg-primary bg-danger').addClass('bg-warning');
                } else {
                    $('#diemRenLuyenBar').removeClass('bg-primary bg-warning').addClass('bg-danger');
                }
            });
            
            // Trigger initial update for progress bars if values exist
            if ($('#diemHocTap').val()) {
                $('#diemHocTap').trigger('input');
            }
            
            if ($('#diemRenLuyen').val()) {
                $('#diemRenLuyen').trigger('input');
            }
            
            // Form validation
            $('#scholarshipForm').on('submit', function(e) {
                if (!$('#confirmCheck').is(':checked')) {
                    e.preventDefault();
                    alert('Vui lòng xác nhận thông tin trước khi gửi!');
                    return false;
                }
                
                return true;
            });
        });
    </script>
}
