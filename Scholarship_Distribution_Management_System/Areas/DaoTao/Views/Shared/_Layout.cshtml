<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Học bổng UTE</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/Logo1.png">
    @* DataTables CSS *@
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/2.0.7/css/dataTables.dataTables.min.css" />
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/responsive/3.0.0/css/responsive.dataTables.min.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString();

    string isActive(string controller) =>
        controller == currentController ? "active" : "";
        
    var hoTen = User.FindFirst("HoTen")?.Value;
    var role = User.Claims.FirstOrDefault(c => c.Type == "VaiTro")?.Value;
}

<body>
    <header>
        <a class="header-left" asp-controller="TrangChu" asp-action="Index" asp-area="DaoTao">
            <img src="~/Images/logo.png" alt="UTE Logo" class="logo">
            <div class="site-title">
                <h1>TRƯỜNG ĐẠI HỌC SƯ PHẠM KỸ THUẬT</h1>
                <p>THE UNIVERSITY OF TECHNOLOGY AND EDUCATION</p>
            </div>
        </a>
        <div class="header-right">
            <div class="user-info-dropdown dropdown">
                <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" id="dropdownUserHeader" data-bs-toggle="dropdown" aria-expanded="false">
                    <img src="~/Images/Avatar.png" alt="Avatar" width="36" height="36" class="rounded-circle me-2">
                    <div class="user-text">
                        <span class="user-name">@hoTen</span>
                        <span class="user-role">@role</span>
                    </div>
                </a>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownUserHeader">
                    <li><a asp-controller="ThongTinTaiKhoan" asp-action="Details" class="dropdown-item">Xem tài khoản</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li> 
                        <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" id="logoutForm">
                            <button type="submit" class="dropdown-item">Đăng xuất</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <nav class="main-nav">
        <div class="nav-container">
            <ul class="nav-links">
                <li><a class="@isActive("TrangChu")" asp-controller="TrangChu" asp-action="Index" asp-area="DaoTao">
                    <i class="fas fa-home"></i> Trang chủ
                </a></li>
                <li><a class="@isActive("QLTaiKhoan")" asp-controller="QLTaiKhoan" asp-action="Index" asp-area="DaoTao">
                    <i class="fas fa-users-cog"></i> Quản lý tài khoản
                </a></li>
                <li><a class="@isActive("DuyetDiemHocTap") @isActive("DotHocBong")" asp-controller="DotHocBong" asp-action="Index" asp-area="DaoTao">
                    <i class="fas fa-check-circle"></i> Duyệt điểm học tập
                </a></li>
            </ul>
        </div>
    </nav>

    <div class="container">
        <main class="main-content">
            @RenderBody()
        </main>
    </div>
    <div class="space-body"></div>
    
    <footer>
        <div class="footer-container">
            <div class="footer-logo">
                <img src="~/Images/logo.png" alt="UTE Logo" class="footer-logo-img">
                <div>
                    <h4>TRƯỜNG ĐẠI HỌC SƯ PHẠM KỸ THUẬT ĐÀ NẴNG</h4>
                    <p>Nâng cao tri thức, kiến tạo tương lai</p>
                </div>
            </div>
            
            <div class="footer-content">
                <div class="footer-section contact-info">
                    <h5><i class="fas fa-map-marked-alt"></i> ĐỊA CHỈ</h5>
                    <p>48 Cao Thắng, Thanh Bình, Hải Châu, Đà Nẵng</p>
                    <p>Khu đô thị Đại học, Hòa Quý, Ngũ Hành Sơn, Đà Nẵng</p>
                </div>
                
                <div class="footer-section contact-info">
                    <h5><i class="fas fa-phone-alt"></i> LIÊN HỆ</h5>
                    <p><i class="fas fa-phone"></i> Điện thoại: 0236 3820303</p>
                    <p><i class="fas fa-envelope"></i> Email: qlcl@ute.udn.vn</p>
                </div>
                
                <div class="footer-section social-links">
                    <h5><i class="fas fa-share-alt"></i> KẾT NỐI</h5>
                    <div class="social-icons">
                        <a href="#" class="social-icon"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="social-icon"><i class="fab fa-youtube"></i></a>
                        <a href="#" class="social-icon"><i class="fab fa-linkedin-in"></i></a>
                        <a href="#" class="social-icon"><i class="fas fa-globe"></i></a>
                    </div>
                    <p class="copyright">© 2025 ĐHSPKT Đà Nẵng. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Global script for the site
        document.addEventListener('DOMContentLoaded', function() {
            // Add smooth scrolling effect
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    document.querySelector(this.getAttribute('href')).scrollIntoView({
                        behavior: 'smooth'
                    });
                });
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)

    @* DataTables JavaScript *@
    <script src="https://cdn.datatables.net/2.0.7/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/3.0.0/js/dataTables.responsive.min.js"></script>
</body>
</html>
