@model Scholarship_Distribution_Management_System.Models.Entities.Diem

@{
    ViewData["Title"] = "Chi tiết điểm";
}

<div class="diem-hoc-tap-container">
    <div class="diem-hoc-tap-header">
        <h2>@ViewData["Title"]</h2>
        <p class="text-muted">Thông tin chi tiết điểm của sinh viên</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row">
                <div class="col-md-8">
                    <div class="detail-section">
                        <h3 class="section-title">Thông tin sinh viên</h3>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <span class="detail-label">Mã sinh viên:</span>
                                    <span class="detail-value">@Model.ID</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Họ và tên:</span>
                                    <span class="detail-value">@Model.User?.HoTen</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Khoa:</span>
                                    <span class="detail-value">@Model.User?.LopSH?.Nganh?.Khoa?.TenKhoa</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <span class="detail-label">Lớp:</span>
                                    <span class="detail-value">@Model.User?.LopSH?.TenLopSH</span>
                                </div>
                                <div class="detail-item">
                                    <span class="detail-label">Ngành:</span>
                                    <span class="detail-value">@Model.User?.LopSH?.Nganh?.TenNganh</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="detail-section mt-4">
                        <h3 class="section-title">Thông tin điểm</h3>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <span class="detail-label">Điểm học tập:</span>
                                    <span class="detail-value score-badge">
                                        @if (Model.DiemHocTap.HasValue)
                                        {
                                            <span class="badge bg-success">@Model.DiemHocTap.Value.ToString("F2")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Chưa có</span>
                                        }
                                    </span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="detail-item">
                                    <span class="detail-label">Điểm rèn luyện:</span>
                                    <span class="detail-value score-badge">
                                        @if (Model.DiemRenLuyen.HasValue)
                                        {
                                            <span class="badge bg-success">@Model.DiemRenLuyen.Value.ToString("F2")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Chưa có</span>
                                        }
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="detail-actions">
                        <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-primary w-100 mb-2">
                            <i class="bi bi-pencil-square"></i> Cập nhật điểm
                        </a>
                        <a asp-action="Index" class="btn btn-secondary w-100">
                            <i class="bi bi-arrow-left"></i> Quay lại danh sách
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/diemHocTap.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/diemHocTap.css" />
}
