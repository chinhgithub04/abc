@model Scholarship_Distribution_Management_System.Models.Entities.Diem

@{
    ViewData["Title"] = "Cập nhật điểm";
}

<div class="diem-hoc-tap-container">
    <div class="diem-hoc-tap-header">
        <h2>@ViewData["Title"]</h2>
        <p class="text-muted">Cập nhật thông tin điểm học tập cho sinh viên</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="ID" />

                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-info-group">
                            <label class="info-label">Mã sinh viên</label>
                            <div class="info-value">@Model.ID</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-info-group">
                            <label class="info-label">Họ và tên</label>
                            <div class="info-value">@Model.User?.HoTen</div>
                        </div>
                    </div>
                </div>                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="form-info-group">
                            <label class="info-label">Lớp</label>
                            <div class="info-value">@Model.User?.LopSH?.TenLopSH</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-info-group">
                            <label class="info-label">Ngành</label>
                            <div class="info-value">@Model.User?.LopSH?.Nganh?.TenNganh</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-info-group">
                            <label class="info-label">Khoa</label>
                            <div class="info-value">@Model.User?.LopSH?.Nganh?.Khoa?.TenKhoa</div>
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="DiemHocTap" class="control-label">Điểm học tập</label>
                            <input asp-for="DiemHocTap" class="form-control" placeholder="Nhập điểm học tập" />
                            <span asp-validation-for="DiemHocTap" class="text-danger"></span>
                            <small class="form-text text-muted">Nhập điểm học tập thang điểm 4 (Ví dụ: 3.5)</small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="DiemRenLuyen" class="control-label">Điểm rèn luyện</label>
                            <input asp-for="DiemRenLuyen" class="form-control" placeholder="Nhập điểm rèn luyện" />
                            <span asp-validation-for="DiemRenLuyen" class="text-danger"></span>
                            <small class="form-text text-muted">Nhập điểm rèn luyện thang điểm 100 (Ví dụ: 85)</small>
                        </div>
                    </div>
                </div>

                <div class="form-group mt-4 d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại danh sách
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/diemHocTap.js"></script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@section Styles {
    <link rel="stylesheet" href="~/css/diemHocTap.css" />
}
