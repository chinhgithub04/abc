@model Scholarship_Distribution_Management_System.Models.ViewModel.TaiKhoanDayDuViewModel

@{
    ViewData["Title"] = "Thêm tài khoản";
}

<h2>Thêm tài khoản</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label>Mã sinh viên</label>
        <input asp-for="ID" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Họ tên</label>
        <input asp-for="HoTen" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Ngày sinh</label>
        <input asp-for="NgaySinh" class="form-control" type="date" />
    </div>
    <div class="form-group">
        <label>Giới tính</label>
        <select asp-for="GioiTinh" class="form-control">
            <option value="Nam">Nam</option>
            <option value="Nữ">Nữ</option>
        </select>
    </div>
    <div class="form-group">
        <label>Địa chỉ</label>
        <input asp-for="DiaChi" class="form-control" />
    </div>
    <div class="form-group">
        <label>Email</label>
        <input asp-for="Email" class="form-control" />
    </div>
    <div class="form-group">
        <label>Số điện thoại</label>
        <input asp-for="SDT" class="form-control" />
    </div>
    <div class="form-group">
        <label>Vai trò</label>
        <select asp-for="VaiTro" class="form-control">
            <option value="SinhVien">Sinh viên</option>
            <option value="DaoTao">Phòng đào tạo</option>
            <option value="CTSV">Phòng CTSV</option>
            <option value="Doan">Phòng đoàn</option>
            <option value="NghienCuu">Phòng NC-KH</option>
            <option value="HoiDong">Phòng hội đồng</option>
            <option value="TaiChinh">Phòng tài chính</option>
            <option value="Admin">Quản trị viên</option>
        </select>
    </div>

    <div class="form-group">
        <label>Mật khẩu</label>
        <input asp-for="Password" type="password" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-success mt-3">Tạo tài khoản</button>
    <a asp-action="Index" class="btn btn-secondary mt-3">Quay lại</a>
</form>
