@model Scholarship_Distribution_Management_System.Models.Entities.NghienCuuKhoaHoc
@{
    ViewData["Title"] = "Chi tiết đề tài";
}

<h2>@ViewData["Title"]</h2>

<div class="form-group mb-3">
    <strong>ID:</strong>
    @Model.ID
</div>
<div class="form-group mb-3">
    <strong>Tên đề tài:</strong>
    @Model.TenDeTai
</div>
<div class="form-group mb-3">
    <strong>Thành tích:</strong>
    @Model.ThanhTich
</div>

<a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-warning">Sửa</a>
<a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
