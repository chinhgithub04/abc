@model Scholarship_Distribution_Management_System.Models.Entities.NghienCuuKhoaHoc
@{
    ViewData["Title"] = "Thêm đề tài";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create" method="post">
    <div class="form-group mb-2">
        <label asp-for="ID" class="control-label">Mã</label>
        <input asp-for="ID" class="form-control" />
        <span asp-validation-for="ID" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="TenDeTai" class="control-label">Tên đề tài</label>
        <input asp-for="TenDeTai" class="form-control" />
        <span asp-validation-for="TenDeTai" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="ThanhTich" class="control-label">Thành tích</label>
        <input asp-for="ThanhTich" class="form-control" />
        <span asp-validation-for="ThanhTich" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-success">Lưu</button>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</form>
