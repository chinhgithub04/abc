@model Scholarship_Distribution_Management_System.Models.ViewModel.InfoHocBongViewModel

@{
    ViewData["Title"] = "Chi tiết duyệt điểm rèn luyện";
}

<div class="duyet-diem-container">
    <div class="duyet-diem-header">
        <h2>@ViewData["Title"]</h2>
        <p class="text-muted">Thông tin chi tiết về điểm rèn luyện của sinh viên</p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <!-- Phần so sánh điểm học tập và rèn luyện -->
            <div class="score-comparison">
                <h5 class="score-title">Thông tin điểm số</h5>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="score-item">
                            <div class="row align-items-center">
                                <div class="col-6 text-center">
                                    <div class="score-label">Điểm học tập (SV)</div>
                                    <div class="score-value student-score">
                                        @if (Model.DiemHocTap.HasValue)
                                        {
                                            @string.Format("{0:0.00}", Model.DiemHocTap)
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </div>
                                </div>
                                <div class="col-6 text-center">
                                    <div class="score-label">Kết quả điểm HT</div>
                                    <div class="score-value actual-score">
                                        @if (Model.KQDiemHT.HasValue)
                                        {
                                            @string.Format("{0:0.00}", Model.KQDiemHT)
                                        }
                                        else
                                        {
                                            <span>Chưa duyệt</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="score-item">
                            <div class="row align-items-center">
                                <div class="col-6 text-center">
                                    <div class="score-label">Điểm rèn luyện</div>
                                    <div class="score-value student-score">
                                        @if (Model.DiemRenLuyen.HasValue)
                                        {
                                            @((int)Model.DiemRenLuyen.Value)
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </div>
                                </div>
                                <div class="col-6 text-center">
                                    <div class="score-label">Kết quả điểm rèn luyện</div>
                                    <div class="score-value actual-score">
                                        @if (Model.KQDiemRL.HasValue)
                                        {
                                            @((int)Model.KQDiemRL.Value)
                                        }
                                        else
                                        {
                                            <span>Chưa duyệt</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-12">
                        <div class="alert @(Model.KQDiemRL == null ? "alert-warning" : (Model.KQDiemRL == Model.DiemRenLuyen ? "alert-success" : "alert-danger"))">
                            <div class="d-flex align-items-center">
                                @if (Model.KQDiemRL == null && Model.TrangThaiDon == 1)
                                {
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <text><strong>Trạng thái: Chờ xử lý</strong> - Đơn đang chờ duyệt điểm rèn luyện.</text>
                                }
                                else if (Model.KQDiemRL == Model.DiemRenLuyen && Model.TrangThaiDon == 1)
                                {
                                    <i class="bi bi-check-circle-fill me-2"></i>
                                    <text><strong>Trạng thái: Đã duyệt</strong> - Điểm rèn luyện đã được xác nhận.</text>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle-fill me-2"></i>
                                    <text><strong>Trạng thái: Từ chối</strong> - Điểm rèn luyện không khớp với thông tin khai báo.</text>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Thông tin sinh viên -->
            <div class="student-info-section">
                <h5 class="section-title">Thông tin sinh viên</h5>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Mã sinh viên</div>
                        <div class="info-value">@Model.SinhVienId</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Họ và tên</div>
                        <div class="info-value">@Model.HoTen</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Giới tính</div>
                        <div class="info-value">@Model.GioiTinh</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Ngày sinh</div>
                        <div class="info-value">@Model.NgaySinh?.ToShortDateString()</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Email</div>
                        <div class="info-value">@Model.Email</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Lớp</div>
                        <div class="info-value">@Model.TenLopSH</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Ngành</div>
                        <div class="info-value">@Model.TenNganh</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Khoa</div>
                        <div class="info-value">@Model.TenKhoa</div>
                    </div>
                </div>
            </div>

            <!-- Thông tin đơn học bổng -->
            <div class="application-info-section">
                <h5 class="section-title">Thông tin đơn học bổng</h5>
                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Mã đơn</div>
                        <div class="info-value">@Model.DonHocBongId</div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Ngày nộp đơn</div>
                        <div class="info-value">@Model.NgayNop?.ToShortDateString()</div>
                    </div>
                </div>
            </div>

            <div class="form-group mt-4">
                <a asp-action="Index" asp-route-IdDot="@Model.DotHocBongId" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/duyetDiemRenLuyen.js"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/duyetDiemRenLuyen.css" />
}