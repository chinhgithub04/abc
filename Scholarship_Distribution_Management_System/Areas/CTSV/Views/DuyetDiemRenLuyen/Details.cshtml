@model Scholarship_Distribution_Management_System.Models.ViewModel.InfoHocBongViewModel

@{
    ViewData["Title"] = "Chi tiết duyệt điểm rèn luyện";
}

<div class="simple-details-container">
    <h1 class="details-title">@ViewData["Title"]</h1>
    <div class="details-section">
        <h2>Thông tin sinh viên</h2>
        <dl>
            <dt>Mã sinh viên</dt>
            <dd>@Model.SinhVienId</dd>
            <dt>Họ và tên</dt>
            <dd>@Model.HoTen</dd>
            <dt>Giới tính</dt>
            <dd>@Model.GioiTinh</dd>
            <dt>Ngày sinh</dt>
            <dd>@Model.NgaySinh?.ToShortDateString()</dd>
            <dt>Email</dt>
            <dd>@Model.Email</dd>
            <dt>Lớp</dt>
            <dd>@Model.TenLopSH</dd>
            <dt>Ngành</dt>
            <dd>@Model.TenNganh</dd>
            <dt>Khoa</dt>
            <dd>@Model.TenKhoa</dd>
        </dl>
    </div>
    <div class="details-section">
        <h2>Thông tin đơn học bổng</h2>
        <dl>
            <dt>Mã đơn</dt>
            <dd>@Model.DonHocBongId</dd>
            <dt>Ngày nộp đơn</dt>
            <dd>@Model.NgayNop?.ToShortDateString()</dd>
        </dl>
    </div>
    <div class="details-section">
        <h2>Điểm số</h2>
        <dl>
            <dt>Điểm học tập (SV)</dt>
            <dd>@(Model.DiemHocTap.HasValue ? string.Format("{0:0.00}", Model.DiemHocTap) : "-")</dd>
            <dt>Kết quả điểm HT</dt>
            <dd>@(Model.KQDiemHT.HasValue ? string.Format("{0:0.00}", Model.KQDiemHT) : "Chưa duyệt")</dd>
            <dt>Điểm rèn luyện</dt>
            <dd>@(Model.DiemRenLuyen.HasValue ? ((int)Model.DiemRenLuyen.Value).ToString() : "-")</dd>
            <dt>Kết quả điểm rèn luyện</dt>
            <dd>@(Model.KQDiemRL.HasValue ? ((int)Model.KQDiemRL.Value).ToString() : "Chưa duyệt")</dd>
        </dl>
    </div>
    <div class="details-section">
        <h2>Trạng thái</h2>
        <div class="status-block">
            @if (Model.KQDiemRL == null && Model.TrangThaiDon == 1)
            {
                <span class="status-label status-wait">Chờ xử lý</span>
                <span class="status-desc">Đơn đang chờ duyệt điểm rèn luyện.</span>
            }
            else if (Model.KQDiemRL == Model.DiemRenLuyen && Model.TrangThaiDon == 1)
            {
                <span class="status-label status-done">Đã duyệt</span>
                <span class="status-desc">Điểm rèn luyện đã được xác nhận.</span>
            }
            else
            {
                <span class="status-label status-reject">Từ chối</span>
                <span class="status-desc">Điểm rèn luyện không khớp với thông tin khai báo.</span>
            }
        </div>
    </div>
    <div class="details-actions">
        <a asp-action="Index" asp-route-IdDot="@Model.DotHocBongId" class="back-btn">⬅ Quay lại danh sách</a>
    </div>
</div>

@section Styles {
    <style>
        .simple-details-container {
            max-width: 700px;
            margin: 30px auto;
            background: #fff;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
            padding: 32px 24px 24px 24px;
        }
        .details-title {
            font-size: 1.6rem;
            color: #2c3e50;
            margin-bottom: 18px;
            text-align: center;
        }
        .details-section {
            margin-bottom: 28px;
        }
        .details-section h2 {
            font-size: 1.1rem;
            color: #0966aa;
            margin-bottom: 10px;
            border-left: 3px solid #0966aa;
            padding-left: 8px;
        }
        dl {
            display: grid;
            grid-template-columns: 160px 1fr;
            row-gap: 8px;
            column-gap: 12px;
            margin: 0;
        }
        dt {
            color: #666;
            font-weight: 500;
            text-align: right;
        }
        dd {
            margin: 0;
            color: #222;
            font-weight: 400;
        }
        .status-block {
            padding: 12px 16px;
            border-radius: 5px;
            background: #f8f9fa;
            display: flex;
            flex-direction: column;
            gap: 6px;
            align-items: flex-start;
        }
        .status-label {
            font-weight: 600;
            padding: 4px 12px;
            border-radius: 4px;
            font-size: 1rem;
        }
        .status-wait {
            background: #fffbe6;
            color: #d48806;
        }
        .status-done {
            background: #e6ffed;
            color: #2c9e3c;
        }
        .status-reject {
            background: #ffeaea;
            color: #e74c3c;
        }
        .status-desc {
            font-size: 0.98rem;
            color: #555;
        }
        .details-actions {
            text-align: center;
            margin-top: 18px;
        }
        .back-btn {
            display: inline-block;
            background: #f5f5f5;
            color: #444;
            border-radius: 4px;
            padding: 8px 18px;
            text-decoration: none;
            font-weight: 500;
            transition: background 0.2s;
        }
        .back-btn:hover {
            background: #e8e8e8;
        }
        @@media (max-width: 600px) {
            .simple-details-container {
                padding: 16px 4px;
            }
            dl {
                grid-template-columns: 1fr;
            }
            dt {
                text-align: left;
            }
        }
    </style>
}