@model IEnumerable<Scholarship_Distribution_Management_System.Models.Entities.DotHocBong>

@{
    ViewData["Title"] = "Quản lý đợt học bổng";
}

<h2>@ViewData["Title"]</h2>
<a class="btn btn-primary mb-3" asp-action="Create">Thêm đợt học bổng</a>


<table id="dotHocBongTable" class="display table table-striped table-bordered mt-3" style="width:100%">
    <thead>
        <tr>
            <th>STT</th>
            <th>Tên đợt</th>
            <th>Ngày tạo</th>
            <th>Trạng thái</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var now = DateTime.UtcNow;

            string statusText;
            string statusColor;

            if (item.TrangThai == 0)
            {
                statusText = "Đã hủy";
                statusColor = "danger";
            }
            else if (item.TrangThai == 1)
            {
                if (now < item.NgayBatDauNop)
                {
                    statusText = "Sắp mở";
                    statusColor = "info";
                }
                else if (now >= item.NgayBatDauNop && now <= item.NgayKetThuc)
                {
                    statusText = "Đang mở";
                    statusColor = "success";
                }
                else if (now > item.NgayKetThuc)
                {
                    statusText = "Kết thúc";
                    statusColor = "secondary";
                }
                else
                {
                    statusText = "Không xác định";
                    statusColor = "dark";
                }
            }
            else
            {
                statusText = "Không xác định";
                statusColor = "dark";
            }

            <tr>
                <td>@(Model.ToList().IndexOf(item) + 1)</td>
                <td>@item.TenDot</td>
                <td>@item.NgayTao.ToString("dd/MM/yyyy")</td>
                <td><span class="badge bg-@statusColor">@statusText</span></td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info">Xem</a>
                    <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning">Sửa</a>
                    @if (item.TrangThai == 1)
                    {
                        <form asp-action="Delete" asp-route-id="@item.ID" method="post" style="display:inline;"
                        onsubmit="return confirm('Bạn có chắc muốn hủy đợt này?');">
                            <button type="submit" class="btn btn-sm btn-danger">Hủy</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="CancelDelete" asp-route-id="@item.ID" method="post" style="display:inline;"
                              onsubmit="return confirm('Bạn có chắc muốn trả lại đợt này?');">
                            <button type="submit" class="btn btn-sm btn-danger">Hoàn tác</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#dotHocBongTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Vietnamese.json" // Ngôn ngữ tiếng Việt
                },
                "paging": true,       // Bật phân trang
                "ordering": true,     // Bật sắp xếp cột
                "info": true,         // Bật thông tin bảng (Hiển thị X đến Y của Z mục)
                "searching": true,    // Bật ô tìm kiếm toàn cục
                "responsive": true    // Bật chế độ responsive cho bảng
            });
        });
    </script>
}
