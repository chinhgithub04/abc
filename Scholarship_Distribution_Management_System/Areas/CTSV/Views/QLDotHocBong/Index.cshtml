@model IEnumerable<Scholarship_Distribution_Management_System.Models.Entities.DotHocBong>

@{
    ViewData["Title"] = "Quản lý đợt học bổng";
}

<h2>@ViewData["Title"]</h2>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<table id="dotHocBongTable" class="display table table-striped table-bordered mt-3" style="width:100%">
    <thead>
        <tr>
            <th>Tên đợt</th>
            <th>Số lượng</th>
            <th>Tiền</th>
            <th>Ngày bắt đầu nộp</th>
            <th>Ngày kết thúc nộp</th>
            <th>Trạng thái</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var now = DateTime.UtcNow;

            string statusText;
            string statusColor;

            if (item.TrangThai == 0)
            {
                statusText = "Đã hủy";
                statusColor = "danger";
            }
            else if (item.TrangThai == 1)
            {
                if (now < item.NgayBatDauNop)
                {
                    statusText = "Sắp mở";
                    statusColor = "info";
                }
                else if (now >= item.NgayBatDauNop && now <= item.NgayKetThucNop)
                {
                    statusText = "Đang mở";
                    statusColor = "success";
                }
                else if (now > item.NgayKetThucNop && now <= item.NgayKetThuc)
                {
                    statusText = "Đang xét duyệt";
                    statusColor = "warning";
                }
                else if (now > item.NgayKetThuc)
                {
                    statusText = "Kết thúc";
                    statusColor = "secondary";
                }
                else
                {
                    statusText = "Không xác định";
                    statusColor = "dark";
                }
            }
            else
            {
                statusText = "Không xác định";
                statusColor = "dark";
            }

            <tr>
                <td>@item.TenDot</td>
                <td>@item.SoLuong</td>
                <td>@item.Tien.ToString("N0") VND</td>
                <td>@item.NgayBatDauNop.ToString("dd/MM/yyyy")</td>
                <td>@item.NgayKetThucNop.ToString("dd/MM/yyyy")</td>
                <td><span class="badge bg-@statusColor">@statusText</span></td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning">Sửa</a>
                    <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info">Chi tiết</a>
                    <form asp-action="Delete" asp-route-id="@item.ID" method="post" style="display:inline;"
                          onsubmit="return confirm('Bạn có chắc muốn hủy đợt này?');">
                        <button type="submit" class="btn btn-sm btn-danger">Hủy</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        $('#dotHocBongTable').DataTable({
            language: {
                search: "Tìm kiếm:",
                lengthMenu: "Hiển thị _MENU_ dòng",
                info: "Hiển thị _START_ đến _END_ trong tổng _TOTAL_ dòng",
                paginate: {
                    previous: "Trước",
                    next: "Tiếp"
                }
            }
        });
    });
</script>
