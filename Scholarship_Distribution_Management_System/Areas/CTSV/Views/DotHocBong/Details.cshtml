@model Scholarship_Distribution_Management_System.Models.Entities.DotHocBong

@using Microsoft.AspNetCore.Identity
@using Scholarship_Distribution_Management_System.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@using System.Security.Claims

@{
    ViewData["Title"] = "Chi tiết đợt học bổng";
}

<div class="scholarship-detail-container">
    <div class="detail-header">
        <div class="header-content">
            <h1>Chi tiết đợt học bổng</h1>
            <h2>@Model.TenDot</h2>
            
            @{
                var now = DateTime.UtcNow;
                string statusText;
                string statusClass;

                if (now < Model.NgayBatDauNop)
                {
                    statusText = "Sắp mở";
                    statusClass = "status-upcoming";
                }
                else if (now >= Model.NgayBatDauNop && now <= Model.NgayKetThucNop)
                {
                    statusText = "Đang mở";
                    statusClass = "status-open";
                }
                else if (now > Model.NgayKetThucNop && now <= Model.NgayKetThuc)
                {
                    statusText = "Đang xét duyệt";
                    statusClass = "status-review";
                }
                else if (now > Model.NgayKetThuc)
                {
                    statusText = "Kết thúc";
                    statusClass = "status-closed";
                }
                else
                {
                    statusText = "Không xác định";
                    statusClass = "status-unknown";
                }
            }
            
            <div class="status-badge @statusClass">@statusText</div>
        </div>
        <a asp-action="Index" class="back-button">⬅ Quay lại</a>
    </div>
    
    <div class="detail-content">
        <div class="info-panel">
            <div class="panel-header">
                <i class="fas fa-info-circle"></i> Thông tin cơ bản
            </div>
            <div class="panel-body">
                <div class="info-item">
                    <div class="info-label">Điều kiện</div>
                    <div class="info-value">@Model.DieuKien</div>
                </div>
                
                <div class="info-row">
                    <div class="info-item">
                        <div class="info-label">Số lượng</div>
                        <div class="info-value highlight">@Model.SoLuong suất</div>
                    </div>
                    
                    <div class="info-item">
                        <div class="info-label">Tiền học bổng</div>
                        <div class="info-value highlight">@Model.Tien.ToString("N0") VNĐ</div>
                    </div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Người phụ trách</div>
                    <div class="info-value">@Model.NhanVien?.HoTen</div>
                </div>
                
                <div class="info-item">
                    <div class="info-label">Ngày tạo</div>
                    <div class="info-value">@Model.NgayTao.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        </div>
        
        <div class="timeline-panel">
            <div class="panel-header">
                <i class="fas fa-calendar-alt"></i> Thời gian thực hiện
            </div>
            <div class="panel-body">
                <div class="timeline">
                    <div class="timeline-item">
                        <div class="timeline-marker"></div>
                        <div class="timeline-content">
                            <div class="timeline-date">@Model.NgayBatDauNop.ToString("dd/MM/yyyy")</div>
                            <div class="timeline-title">Bắt đầu nhận hồ sơ</div>
                        </div>
                    </div>
                    
                    <div class="timeline-item">
                        <div class="timeline-marker"></div>
                        <div class="timeline-content">
                            <div class="timeline-date">@Model.NgayKetThucNop.ToString("dd/MM/yyyy")</div>
                            <div class="timeline-title">Kết thúc nhận hồ sơ</div>
                        </div>
                    </div>
                    
                    <div class="timeline-item">
                        <div class="timeline-marker"></div>
                        <div class="timeline-content">
                            <div class="timeline-date">@Model.NgayHoiDongDuyet.ToString("dd/MM/yyyy")</div>
                            <div class="timeline-title">Hội đồng bắt đầu xét duyệt</div>
                        </div>
                    </div>
                    
                    <div class="timeline-item">
                        <div class="timeline-marker"></div>
                        <div class="timeline-content">
                            <div class="timeline-date">@Model.NgayPTCDuyet.ToString("dd/MM/yyyy")</div>
                            <div class="timeline-title">Phòng tài chính duyệt</div>
                        </div>
                    </div>
                    
                    <div class="timeline-item">
                        <div class="timeline-marker"></div>
                        <div class="timeline-content">
                            <div class="timeline-date">@Model.NgayKetThuc.ToString("dd/MM/yyyy")</div>
                            <div class="timeline-title">Kết thúc đợt học bổng</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>        
    </div>
</div>

<style>
    .scholarship-detail-container {
        max-width: 900px;
        margin: 0 auto;
    }
    
    .detail-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #ddd;
    }
    
    .header-content h1 {
        font-size: 24px;
        margin: 0 0 5px 0;
        color: #333;
    }
    
    .header-content h2 {
        font-size: 18px;
        margin: 0 0 10px 0;
        color: #555;
        font-weight: 500;
    }
    
    .status-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 4px;
        font-size: 14px;
        font-weight: 500;
    }
    
    .status-upcoming {
        background-color: #e6f7ff;
        color: #0966aa;
        border: 1px solid #91d5ff;
    }
    
    .status-open {
        background-color: #e6ffed;
        color: #2c9e3c;
        border: 1px solid #aae0b3;
    }
    
    .status-review {
        background-color: #fffbe6;
        color: #d48806;
        border: 1px solid #ffe58f;
    }
    
    .status-closed {
        background-color: #f5f5f5;
        color: #595959;
        border: 1px solid #d9d9d9;
    }
    
    .status-unknown {
        background-color: #f5f5f5;
        color: #262626;
        border: 1px solid #d9d9d9;
    }
    
    .back-button {
        display: inline-block;
        padding: 8px 16px;
        background-color: #f5f5f5;
        color: #444;
        border-radius: 4px;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s;
    }
    
    .back-button:hover {
        background-color: #e8e8e8;
    }
    
    .detail-content {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
    }
    
    .info-panel, .timeline-panel, .progress-panel {
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 4px;
        overflow: hidden;
    }
    
    .panel-header {
        padding: 12px 15px;
        background-color: #f5f5f5;
        border-bottom: 1px solid #ddd;
        font-weight: 600;
        color: #333;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    
    .panel-body {
        padding: 15px;
    }
    
    .info-item {
        margin-bottom: 15px;
    }
    
    .info-item:last-child {
        margin-bottom: 0;
    }
    
    .info-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 15px;
    }
    
    .info-label {
        font-size: 14px;
        color: #666;
        margin-bottom: 5px;
    }
    
    .info-value {
        font-size: 15px;
        color: #333;
    }
    
    .info-value.highlight {
        font-size: 16px;
        font-weight: 600;
        color: #0966aa;
    }
    
    /* Timeline */
    .timeline {
        position: relative;
        padding-left: 20px;
    }
    
    .timeline:before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        left: 7px;
        width: 2px;
        background-color: #ddd;
    }
    
    .timeline-item {
        position: relative;
        margin-bottom: 20px;
    }
    
    .timeline-item:last-child {
        margin-bottom: 0;
    }
    
    .timeline-marker {
        position: absolute;
        left: -20px;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background-color: #fff;
        border: 2px solid #0966aa;
        z-index: 1;
    }
    
    .timeline-content {
        padding-left: 15px;
    }
    
    .timeline-date {
        font-size: 14px;
        color: #666;
        margin-bottom: 4px;
    }
    
    .timeline-title {
        font-size: 15px;
        font-weight: 500;
        color: #333;
    }
    
    /* Progress */
    .progress-bar-container {
        height: 10px;
        background-color: #f5f5f5;
        border-radius: 5px;
        margin-bottom: 5px;
        overflow: hidden;
    }
    
    .progress-bar {
        height: 100%;
        background-color: #0966aa;
        border-radius: 5px;
        transition: width 0.3s ease;
    }
    
    .progress-label {
        font-size: 14px;
        color: #666;
        text-align: right;
        margin-bottom: 15px;
    }
    
    .current-phase {
        background-color: #f9f9f9;
        padding: 10px;
        border-radius: 4px;
        border-left: 3px solid #0966aa;
    }
    
    .phase-label {
        font-size: 14px;
        color: #666;
        margin-bottom: 4px;
    }
    
    .phase-value {
        font-size: 16px;
        font-weight: 500;
        color: #333;
    }
    
    @@media (max-width: 768px) {
        .detail-header {
            flex-direction: column;
        }
        
        .back-button {
            margin-top: 15px;
            align-self: flex-start;
        }
        
        .info-row {
            grid-template-columns: 1fr;
            gap: 15px;
        }
    }
</style>
