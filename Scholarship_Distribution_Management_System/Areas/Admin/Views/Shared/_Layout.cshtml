<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <a class="header-left" asp-controller="Home" asp-action="Index">
            <img src="~/Images/logo.png" alt="UTE Logo" class="logo"> <div class="site-title">
                <h1>TRƯỜNG ĐẠI HỌC SƯ PHẠM KỸ THUẬT</h1>
                <p>THE UNIVERSITY OF TECHNOLOGY AND EDUCATION</p>
            </div>
        </a>
        <div class="header-right">
            <div class="user-info-dropdown dropdown">
                <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle" id="dropdownUserHeader" data-bs-toggle="dropdown" aria-expanded="false">
                    <img src="~/Images/Avatar.png" alt="Avatar" width="36" height="36" class="rounded-circle me-2">
                    <div class="user-text">
                        @using System.Security.Claims
                        @{
                            var hoTen = User.FindFirst("HoTen")?.Value;
                            var role = User.Claims.FirstOrDefault(c => c.Type == "VaiTro")?.Value;
                        }
                        <span class="user-name">@hoTen</span>
                        <span class="user-role">@User.FindFirst("VaiTro")?.Value</span>
                    </div>
                </a>

                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownUserHeader">
                    <li><a class="dropdown-item" href="#">Xem tài khoản</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" id="logoutForm">
                            <button type="submit" class="dropdown-item">Đăng xuất</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <nav class="main-nav">
        <ul>
            <li><a asp-controller="Home" asp-action="Index" class="active">Trang chủ</a></li>
            <li><a href="#">Thông báo học bổng</a></li>
            <li><a href="#">Danh sách sinh viên nhận học bổng</a></li>
        </ul>
    </nav>

    <div class="container">
        <aside class="sidebar">
            <h2>Phòng đào tạo</h2>
            <ul>
                <li><a href="#">Quản lý tài khoản</a></li>
                <li><a href="#">Danh sách hồ sơ học bổng</a></li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" id="logoutForm">
                        <button type="submit" class="dropdown-item">Đăng xuất</button>
                    </form>
                </li>
            </ul>
        </aside>

        <main class="main-content">
            @RenderBody()
        </main>
    </div>
    <div class="space-body"></div>
    <footer>
        <div class="footer-section">
            <h4>TRƯỜNG ĐẠI HỌC SƯ PHẠM KỸ THUẬT</h4>
            <p><i class="fas fa-map-marker-alt"></i> Cơ sở 1: 48 Cao Thắng, Thanh Bình, Hải Châu, Đà Nẵng</p>
            <p><i class="fas fa-map-marker-alt"></i> Cơ sở 2: Khu đô thị Đại học, Hòa Quý, Ngũ Hành Sơn, Đà Nẵng</p>
        </div>
        <div class="footer-section">
            <h4>THÔNG TIN LIÊN LẠC</h4>
            <p><i class="fas fa-phone"></i> Điện thoại: 0236 3820303</p>
            <p><i class="fas fa-envelope"></i> Email: qlcl@ute.udn.vn</p>
        </div>
        <div class="footer-section">
            <h4>KẾT NỐI ĐẾN TRƯỜNG</h4>
            <div class="social-icons">
                <a href="#" target="_blank"><i class="fab fa-facebook-f"></i></a>
                <a href="#" target="_blank"><i class="fab fa-youtube"></i></a>
                <a href="#" target="_blank"><i class="fab fa-google-plus-g"></i></a>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
